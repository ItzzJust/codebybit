{
  "name": "codebybit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "moon run :dev",
    "build": "moon run :build",
    "preview": "moon run :preview",
    "typecheck": "moon run :typecheck",
    "test": "moon run :test",
    "test:watch": "moon run :test-watch",
    "check": "pnpm exec ultracite check",
    "fix": "pnpm exec ultracite fix",
    "doctor": "pnpm exec ultracite doctor",
    "db:generate": "moon run web:db-generate",
    "db:push": "moon run web:db-push",
    "db:migrate": "moon run web:db-migrate",
    "db:studio": "moon run web:db-studio",
    "react-doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@tanstack/markdown": "^0.0.13",
    "@tanstack/react-hotkeys": "^0.10.0",
    "ioredis": "^6.0.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@moonrepo/cli": "^2.5.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-plugin-react-doctor": "^0.9.12",
    "react-doctor": "^0.9.12",
    "ultracite": "7.10.7"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.15.0"
}
