{
  "name": "codebybit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "moon run :dev",
    "build": "moon run :build",
    "preview": "moon run :preview",
    "typecheck": "moon run :typecheck",
    "test": "moon run :test",
    "test:watch": "moon run :test-watch",
    "check": "bun x ultracite check",
    "fix": "bun x ultracite fix",
    "doctor": "bun x ultracite doctor",
    "db:generate": "moon run web:db-generate",
    "db:push": "moon run web:db-push",
    "db:migrate": "moon run web:db-migrate",
    "db:studio": "moon run web:db-studio",
    "react-doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@tanstack/markdown": "^0.0.13",
    "@tanstack/react-hotkeys": "^0.10.0"
  },
  "devDependencies": {
    "@moonrepo/cli": "^2.5.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.79.0",
    "oxlint-plugin-react-doctor": "^0.7.8",
    "react-doctor": "^0.9.12",
    "ultracite": "7.10.4"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.12"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@moonrepo/cli"
  ]
}
